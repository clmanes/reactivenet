{
  "name": "reactivenet-platform",
  "private": true,
  "version": "1.1.37",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clmanes/reactivenet.git"
  },
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch",
    "dev": "vite",
    "icons": "bun scripts/generate-icons.mjs",
    "test": "rescript && bun test $(find ./src -name '*_test.res.mjs' | sort) && bun scripts/test-guide.mjs",
    "test:guide": "bun scripts/test-guide.mjs",
    "test:watch": "bun test --watch $(find ./src -name '*_test.res.mjs' | sort)",
    "build": "bun scripts/version.mjs auto && vite build",
    "preview": "vite preview",
    "spectrum:registry": "bun scripts/generate-spectrum-registry.mjs",
    "spectrum:icons": "bun scripts/generate-spectrum-icons.mjs",
    "pyodide:assets": "bun scripts/copy-pyodide.mjs",
    "release": "bun scripts/version.mjs",
    "pb": "bun scripts/pocketbase.mjs",
    "mcp": "bun mcp/server.mjs",
    "od": "bun data/server.mjs",
    "clips": "bun scripts/record-clips.mjs",
    "shots": "bun scripts/record-shots.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.0",
    "@blocknote/core": "^0.53.0",
    "@blocknote/mantine": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@finos/perspective": "^3.8.0",
    "@finos/perspective-viewer": "^3.8.0",
    "@finos/perspective-viewer-d3fc": "^3.8.0",
    "@finos/perspective-viewer-datagrid": "^3.8.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rescript/react": "^0.14.0",
    "@spectrum-web-components/action-button": "^1.12.2",
    "@spectrum-web-components/bundle": "^1.12.2",
    "@spectrum-web-components/button": "^1.12.2",
    "@spectrum-web-components/field-label": "^1.12.2",
    "@spectrum-web-components/menu": "^1.12.2",
    "@spectrum-web-components/picker": "^1.12.2",
    "@spectrum-web-components/switch": "^1.12.2",
    "@spectrum-web-components/textfield": "^1.12.2",
    "@spectrum-web-components/theme": "^1.12.2",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "katex": "^0.18.3",
    "leaflet": "^1.9.4",
    "marked": "^18.0.9",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.16.1",
    "pyodide": "^314.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rescript": "12.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.0",
