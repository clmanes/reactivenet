# Copia questo file in deploy.env (gitignorato) e compila gli indirizzi.
# deploy.sh lo legge all'avvio; le stesse variabili passate nell'ambiente
# vincono su quelle del file. Il repository è pubblico: gli indirizzi reali
# della produzione non vanno mai committati.

# Server app: Caddy + sito + app + PocketBase + server MCP.
# Conviene l'indirizzo VPN, così l'SSH del deploy non passa da Internet.
APP_HOST="utente@10.0.0.1"
APP_DIR="/srv/reactivenet"

# Server dati: servizio open data + warehouse DuckDB.
# Conviene l'indirizzo LAN (il warehouse pesa gigabyte); l'indirizzo di
# SERVIZIO resta quello VPN cablato nel Caddyfile — vedi deploy.sh.
DATA_HOST="utente@192.168.0.2"
DATA_DIR="/srv/reactivenet/data"
