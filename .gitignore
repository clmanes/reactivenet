# .version-stamp.json is deliberately NOT ignored: it is what makes the automatic
# patch bump idempotent, and a clone without it would bump on its first build of an
# unchanged tree.

# Production addresses for deploy.sh — the repo is public, the network is not.
# Copy deploy.env.example and fill it in.
deploy.env

# Claude Code's per-machine settings (the shared ones, if any, are versioned).
.claude/settings.local.json

# Vendored Pyodide core, 13 MB regenerated by `bun run pyodide:assets`.
public/pyodide/

# The PocketBase binary and its data; the schema and hooks live in pb/.
.pocketbase/

# The open-data service (data/): code and ETL are versioned, the warehouses they
# build and download are not — gigabytes of DuckDB and raw source files that
# `data/etl` reproduces.
data/*.duckdb
data/*.duckdb.wal
data/raw/
data/model-cache/
data/etl-state.json

# le riprese di prova di scripts/record-clips.mjs, finché non si pubblicano
clip-nuove/

# le schermate di prova di scripts/record-shots.mjs, finché non si pubblicano
shots-nuovi/
